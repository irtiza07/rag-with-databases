# ---------------------------------------------------------------
# Copy this file to ".env" (same folder) and fill in your key:
#     cp .env.example .env
# ---------------------------------------------------------------

# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Model used to turn text into vectors (embeddings).
# text-embedding-3-small produces 1536 numbers per piece of text.
# If you change this, also change EMBEDDING_DIMENSIONS in rag_helpers.py.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Model used to write the final answer from the retrieved chunks.
OPENAI_CHAT_MODEL=gpt-6-luna
